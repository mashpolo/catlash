+func (t *PoolClient) begin(ctx context.Context) (context.Context, func(), error) {
+	t.stateMu.Lock()
+	defer t.stateMu.Unlock()
+	if t.closed {
+		return nil, nil, net.ErrClosed
+	}
+	t.operations.Add(1)
+	child, cancel := context.WithCancel(ctx)
+	cancelled := make(chan struct{})
+	stop := context.AfterFunc(t.ctx, func() { cancel(); close(cancelled) })
+	return child, func() {
