+package types
+
+import (
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestClientTasksStopJoinsWorkersAndCancelsRetirement(t *testing.T) {
+	var tasks ClientTasks
+	entered, release := make(chan struct{}), make(chan struct{})
+	tasks.Go(func() { close(entered); <-release })
+	<-entered
+	var retired atomic.Bool
+	tasks.AfterFunc(time.Hour, func() { retired.Store(true) })
+	tasks.Stop()
+	tasks.Stop()
+	if tasks.Go(func() { t.Error("task started after stop") }) {
+		t.Fatal("stop accepted new task")
+	}
+	joined := make(chan struct{})
+	go func() { tasks.Wait(); close(joined) }()
+	select {
+	case <-joined:
+		t.Fatal("wait returned while worker active")
+	case <-time.After(10 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-joined:
+	case <-time.After(time.Second):
+		t.Fatal("stopped retirement timer retained ownership")
+	}
+	if retired.Load() {
+		t.Fatal("retirement timer ran after cancellation")
+	}
+	tasks.mu.Lock()
+	count := len(tasks.timers)
+	tasks.mu.Unlock()
+	if count != 0 {
+		t.Fatal("retained stopped timers")
+	}
+}
