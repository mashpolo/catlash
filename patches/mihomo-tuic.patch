+func TestMobilePoolCloseCancelsPendingDialAndRejectsReuse(t *testing.T) {
+	for _, version := range []int{4, 5} {
+		started := make(chan struct{})
+		var attempts atomic.Int32
+		dial := func(ctx context.Context) (*quic.Conn, error) {
+			attempts.Add(1)
+			close(started)
+			<-ctx.Done()
+			return nil, ctx.Err()
+		}
+		var pool *PoolClient
+		if version == 4 {
+			pool = NewPoolClientV4(&ClientOptionV4{}, dial)
+		} else {
+			pool = NewPoolClientV5(&ClientOptionV5{}, dial)
+		}
+		finished := make(chan error, 1)
+		go func() { _, err := pool.DialContext(context.Background(), &C.Metadata{}); finished <- err }()
+		<-started
+		closed := make(chan error, 1)
+		go func() { closed <- pool.Close() }()
+		select {
+		case err := <-closed:
+			if err != nil {
+				t.Fatal(err)
+			}
+		case <-time.After(time.Second):
+			t.Fatal("pool close did not cancel dial")
+		}
+		if err := <-finished; !errors.Is(err, context.Canceled) {
+			t.Fatalf("dial result: %v", err)
+		}
+		if _, err := pool.DialContext(context.Background(), &C.Metadata{}); !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("closed pool redial: %v", err)
+		}
+		if _, err := pool.ListenPacket(context.Background(), &C.Metadata{}); !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("closed pool UDP: %v", err)
+		}
+		if attempts.Load() != 1 || pool.tcpClients.Len() != 0 || pool.udpClients.Len() != 0 {
+			t.Fatal("closed pool retained clients or redialed")
+		}
+	}
+}
