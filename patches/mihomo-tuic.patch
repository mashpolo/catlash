+package types
+
+import (
+	"sync"
+	"time"
+)
+
+type ClientTasks struct {
+	mu      sync.Mutex
+	closed  bool
+	workers sync.WaitGroup
+	timers  map[*time.Timer]struct{}
+}
+
+func (t *ClientTasks) Go(run func()) bool {
+	t.mu.Lock()
+	if t.closed {
+		t.mu.Unlock()
+		return false
+	}
+	t.workers.Add(1)
+	t.mu.Unlock()
+	go func() { defer t.workers.Done(); run() }()
+	return true
+}
+
+func (t *ClientTasks) GoError(run func() error) bool { return t.Go(func() { _ = run() }) }
+
+func (t *ClientTasks) AfterFunc(delay time.Duration, run func()) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return
+	}
+	if t.timers == nil {
+		t.timers = make(map[*time.Timer]struct{})
+	}
+	t.workers.Add(1)
+	var timer *time.Timer
+	timer = time.AfterFunc(delay, func() {
+		defer t.workers.Done()
+		t.mu.Lock()
+		delete(t.timers, timer)
+		t.mu.Unlock()
+		run()
+	})
+	t.timers[timer] = struct{}{}
+}
+
+func (t *ClientTasks) Stop() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.closed = true
+	for timer := range t.timers {
+		if timer.Stop() {
+			delete(t.timers, timer)
+			t.workers.Done()
+		}
+	}
+}
+
+func (t *ClientTasks) Wait() { t.workers.Wait() }
