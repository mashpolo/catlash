+package lru
+
+type SnapshotEntry[K comparable, V any] struct {
+	Key   K
+	Value V
+}
+
+func (c *LruCache[K, V]) Snapshot() []SnapshotEntry[K, V] {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	entries := make([]SnapshotEntry[K, V], 0, len(c.cache))
+	for item := c.lru.Front(); item != nil; item = item.Next() {
+		entries = append(entries, SnapshotEntry[K, V]{Key: item.Value.key, Value: item.Value.value})
+	}
+	return entries
+}
