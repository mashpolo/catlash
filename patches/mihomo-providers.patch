+package provider
+
+import (
+	"errors"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+	"github.com/metacubex/mihomo/rules/common"
+	"time"
+)
+
+type checkedStrategy struct {
+	ruleStrategy
+	invalid bool
+}
+
+func (s *checkedStrategy) Insert(value string) {
+	count := s.Count()
+	s.ruleStrategy.Insert(value)
+	if s.Count() != count+1 {
+		s.invalid = true
+	}
+}
+func NewMobileRuleProvider(name string, behavior P.RuleBehavior, format P.RuleFormat, data []byte, parse common.ParseRuleFunc) (P.RuleProvider, error) {
+	if format == P.MrsRule {
+		return NewMobileMRSProvider(name, behavior, data)
+	}
+	strategy := &checkedStrategy{ruleStrategy: newStrategy(behavior, parse)}
+	if _, err := rulesParse(data, strategy, format); err != nil {
+		return nil, err
+	}
+	if strategy.invalid {
+		return nil, errors.New("invalid provider rule")
+	}
+	return &InlineProvider{&inlineProvider{baseProvider: baseProvider{behavior: behavior, strategy: strategy.ruleStrategy}, name: name, updateAt: time.Now()}}, nil
+}
+func NewMobileRuleSet(name, target string, source, noResolve bool, provider P.RuleProvider) (*RuleSet, error) {
+	rule, err := NewRuleSet(name, target, source, noResolve)
+	if err != nil {
+		return nil, err
+	}
+	rule.provider = provider
+	return rule, nil
+}
+func BindMobileRuleSet(value any, providers map[string]P.RuleProvider) {
+	if rule, ok := value.(*RuleSet); ok {
+		rule.provider = providers[rule.ruleProviderName]
+	}
+}
+
+var _ C.Rule = (*RuleSet)(nil)
