+	parser, err := newProxiesParser(name, tunnel, schema.Filter, schema.ExcludeFilter, schema.ExcludeType, schema.DialerProxy, schema.Override, schema.AgeSecretKey, hooks)
+	if err != nil {
+		return nil, err
+	}
+	hc := NewHealthCheck(nil, "", 0, 0, true, nil)
+	provider, err := NewInlineProvider(name, nil, func(_ []byte) ([]C.Proxy, error) { return parser(data) }, hc)
+	if err != nil {
+		hc.close()
+		return nil, err
+	}
+	return provider, nil
+}
