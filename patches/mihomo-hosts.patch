+package config
+
+import (
+	"errors"
+
+	"github.com/metacubex/mihomo/component/resolver"
+	"github.com/metacubex/mihomo/component/trie"
+)
+
+func ParseMobileHosts(raw *RawConfig) (*trie.DomainTrie[resolver.HostValue], error) {
+	return parseHosts(raw)
+}
+
+func validateMobileHosts(tree *trie.DomainTrie[resolver.HostValue]) error {
+	states := map[*trie.Node[resolver.HostValue]]uint8{}
+	var visit func(*trie.Node[resolver.HostValue]) bool
+	visit = func(node *trie.Node[resolver.HostValue]) bool {
+		if node == nil || !node.Data().IsDomain || states[node] == 2 {
+			return true
+		}
+		if states[node] == 1 {
+			return false
+		}
+		states[node] = 1
+		if !visit(tree.Search(node.Data().Domain)) {
+			return false
+		}
+		states[node] = 2
+		return true
+	}
+	valid := true
+	tree.Foreach(func(_ string, value resolver.HostValue) bool {
+		valid = valid && (!value.IsDomain || visit(tree.Search(value.Domain)))
+		return valid
+	})
+	if !valid {
+		return errors.New("hosts contains a cycle in domain name mapping")
+	}
+	return nil
+}
