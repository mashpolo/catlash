+package outbound
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/transport/snell"
+)
+
+func TestMobileSnellReuseHonorsDialContext(t *testing.T) {
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	defer close(release)
+	s := &Snell{reuse: true, pool: snell.NewPool(func(ctx context.Context) (*snell.Snell, error) {
+		close(entered)
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-release:
+			return nil, errors.New("fixture released")
+		}
+	})}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	result := make(chan error, 1)
+	go func() { _, err := s.DialContext(ctx, &C.Metadata{}); result <- err }()
+	<-entered
+	cancel()
+	select {
+	case err := <-result:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(50 * time.Millisecond):
+		t.Error("Snell reuse discarded caller cancellation")
+	}
+}
+
+func TestMobileSnellCloseCancelsPendingPoolDial(t *testing.T) {
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	defer close(release)
+	s := &Snell{reuse: true, pool: snell.NewPool(func(ctx context.Context) (*snell.Snell, error) {
+		close(entered)
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-release:
+			return nil, errors.New("fixture released")
+		}
+	})}
+	result := make(chan error, 1)
+	go func() { _, err := s.DialContext(context.Background(), &C.Metadata{}); result <- err }()
+	<-entered
+	if err := s.Close(); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case err := <-result:
+		if err == nil {
+			t.Fatal("closed Snell accepted a pending dial")
+		}
+	case <-time.After(50 * time.Millisecond):
+		t.Error("Snell.Close did not release pending pool dial")
+	}
+}
