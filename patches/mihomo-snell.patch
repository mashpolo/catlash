+package pool
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func mobilePoolClose(t *testing.T, p any) func() error {
+	t.Helper()
+	closer, ok := p.(interface{ Close() error })
+	if !ok {
+		t.Fatal("pool has no explicit Close")
+	}
+	return closer.Close
+}
+
+func TestMobilePoolRecycleReturnsAfterDrain(t *testing.T) {
+	var evicted atomic.Int32
+	p := New(func(context.Context) (int, error) { return 0, nil }, WithEvict(func(int) { evicted.Add(1) }))
+	p.Put(1)
+	done := make(chan struct{})
+	go func() { recycle(p); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(50 * time.Millisecond):
+		t.Fatal("recycle blocked after draining cached item")
+	}
+	if evicted.Load() != 1 {
+		t.Fatal("cached item not evicted")
+	}
+}
+
+func TestMobilePoolCloseWaitsForEvictionAndRejectsReuse(t *testing.T) {
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	t.Cleanup(func() { releaseOnce.Do(func() { close(release) }) })
+	var evicted atomic.Int32
+	var factoryCalls atomic.Int32
+	p := New(func(context.Context) (int, error) { factoryCalls.Add(1); return 99, nil }, WithEvict(func(item int) {
+		evicted.Add(1)
+		if item == 1 {
+			close(entered)
+			<-release
+		}
+	}))
+	closePool := mobilePoolClose(t, p)
+	p.Put(1)
+	first := make(chan struct{})
+	go func() { closePool(); close(first) }()
+	<-entered
+	second := make(chan struct{})
+	go func() { closePool(); close(second) }()
+	select {
+	case <-second:
+		t.Error("concurrent Close returned before eviction finished")
+	case <-time.After(20 * time.Millisecond):
+	}
+	if _, err := p.Get(); err == nil {
+		t.Error("closed pool accepted Get")
+	}
+	p.Put(2)
+	releaseOnce.Do(func() { close(release) })
+	for _, done := range []chan struct{}{first, second} {
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Fatal("Close did not finish")
+		}
+	}
+	if factoryCalls.Load() != 0 || evicted.Load() != 2 {
+		t.Fatalf("factory=%d evictions=%d", factoryCalls.Load(), evicted.Load())
+	}
+}
+
+func TestMobilePoolCloseCancelsAndWaitsForFactory(t *testing.T) {
+	entered := make(chan struct{})
+	cancelled := make(chan struct{})
+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	t.Cleanup(func() { releaseOnce.Do(func() { close(release) }) })
+	var evicted atomic.Int32
+	p := New(func(ctx context.Context) (int, error) {
+		close(entered)
+		<-ctx.Done()
+		close(cancelled)
+		<-release
+		return 42, nil
+	}, WithEvict(func(int) { evicted.Add(1) }))
+	closePool := mobilePoolClose(t, p)
+	result := make(chan error, 1)
+	go func() { _, err := p.Get(); result <- err }()
+	<-entered
+	closed := make(chan struct{})
+	go func() { closePool(); close(closed) }()
+	select {
+	case <-cancelled:
+	case <-time.After(time.Second):
+		t.Fatal("factory context not cancelled")
+	}
+	select {
+	case <-closed:
+		t.Error("Close returned before factory finished")
+	case <-time.After(20 * time.Millisecond):
+	}
+	releaseOnce.Do(func() { close(release) })
+	if err := <-result; err == nil {
+		t.Fatal("late factory value escaped closed pool")
+	}
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("Close did not join factory")
+	}
+	if evicted.Load() != 1 {
+		t.Fatal("late factory item was not evicted")
+	}
+}
+
+func TestMobilePoolCancelledContextDoesNotCheckout(t *testing.T) {
+	p := New(func(context.Context) (int, error) { return 2, nil })
+	closePool := mobilePoolClose(t, p)
+	defer closePool()
+	p.Put(1)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := p.GetContext(ctx); !errors.Is(err, context.Canceled) {
+		t.Fatalf("expected cancellation, got %v", err)
+	}
+	if value, err := p.Get(); err != nil || value != 1 {
+		t.Fatalf("cancelled checkout consumed cached value: %d %v", value, err)
+	}
+}
