+++ b/config/mobile_sniffer.go
@@ -0,0 +1,27 @@
+package config
+
+import (
+	"github.com/metacubex/mihomo/component/sniffer"
+	P "github.com/metacubex/mihomo/constant/provider"
+	RP "github.com/metacubex/mihomo/rules/provider"
+)
+
+func ParseMobileSniffer(raw RawSniffer, providers map[string]P.RuleProvider, geo MobileGeo) (*sniffer.Config, error) {
+	parsed, err := parseSniffer(raw, providers, geo)
+	if err != nil {
+		return nil, err
+	}
+	for _, matcher := range parsed.ForceDomain {
+		RP.BindMobileRuleSet(matcher, providers)
+	}
+	for _, matcher := range parsed.SkipDomain {
+		RP.BindMobileRuleSet(matcher, providers)
+	}
+	for _, matcher := range parsed.SkipSrcAddress {
+		RP.BindMobileRuleSet(matcher, providers)
+	}
+	for _, matcher := range parsed.SkipDstAddress {
+		RP.BindMobileRuleSet(matcher, providers)
+	}
+	return parsed, nil
+}
