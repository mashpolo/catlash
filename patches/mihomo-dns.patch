+package config
+
+import (
+	P "github.com/metacubex/mihomo/constant/provider"
+	"github.com/metacubex/mihomo/dns"
+	RP "github.com/metacubex/mihomo/rules/provider"
+)
+
+func ParseMobileDNS(raw *RawConfig, providers map[string]P.RuleProvider, geo MobileGeo) (*DNS, error) {
+	parsed, err := parseDNS(raw, providers, geo)
+	if err != nil {
+		return nil, err
+	}
+	for _, policies := range [][]dns.Policy{parsed.NameServerPolicy, parsed.ProxyServerPolicy} {
+		for _, policy := range policies {
+			RP.BindMobileRuleSet(policy.Matcher, providers)
+		}
+	}
+	if parsed.FakeIPSkipper != nil {
+		for _, rule := range parsed.FakeIPSkipper.Rules {
+			RP.BindMobileRuleSet(rule, providers)
+		}
+		for _, matcher := range parsed.FakeIPSkipper.Host {
+			RP.BindMobileRuleSet(matcher, providers)
+		}
+	}
+	return parsed, nil
+}
