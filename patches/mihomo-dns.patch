+package dns
+
+import (
+	"context"
+	"sync"
+)
+
+type sessionScopeKey struct{}
+
+type SessionScope struct {
+	ctx    context.Context
+	cancel context.CancelFunc
+	mu     sync.Mutex
+	closed bool
+	tasks  sync.WaitGroup
+}
+
+var ContextProvider func() context.Context
+
+func NewSessionScope(parent context.Context) *SessionScope {
+	ctx, cancel := context.WithCancel(parent)
+	scope := &SessionScope{cancel: cancel}
+	scope.ctx = context.WithValue(ctx, sessionScopeKey{}, scope)
+	return scope
+}
+func (s *SessionScope) Context() context.Context { return s.ctx }
+func (s *SessionScope) begin() (func(), bool) {
+	if s == nil {
+		return func() {}, true
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.closed || s.ctx.Err() != nil {
+		return func() {}, false
+	}
+	s.tasks.Add(1)
+	return s.tasks.Done, true
+}
+func (s *SessionScope) Close() {
+	s.mu.Lock()
+	s.closed = true
+	s.cancel()
+	s.mu.Unlock()
+	s.tasks.Wait()
+}
+func (s *SessionScope) Go(fn func()) bool {
+	done, ok := s.begin()
+	if !ok {
+		return false
+	}
+	go func() { defer done(); fn() }()
+	return true
+}
+func scopeFrom(ctx context.Context) *SessionScope {
+	if ctx == nil {
+		return nil
+	}
+	scope, _ := ctx.Value(sessionScopeKey{}).(*SessionScope)
+	return scope
+}
+func scopedGo(ctx context.Context, fn func()) bool { return scopeFrom(ctx).Go(fn) }
+func resolverScope(ctx context.Context) *SessionScope {
+	if ctx == nil && ContextProvider != nil {
+		ctx = ContextProvider()
+	}
+	if ctx == nil {
+		return nil
+	}
+	if scope := scopeFrom(ctx); scope != nil {
+		return scope
+	}
+	return NewSessionScope(ctx)
+}
+func (r *Resolver) backgroundContext() context.Context {
+	if r.scope != nil {
+		return r.scope.ctx
+	}
+	return context.Background()
+}
+func (r *Resolver) task(fn func()) bool { return r.scope.Go(fn) }
+func (r *Resolver) attach(ctx context.Context) (context.Context, func(), bool) {
+	done, ok := r.scope.begin()
+	if !ok {
+		return ctx, done, false
+	}
+	if r.scope == nil {
+		return ctx, done, true
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(r.scope.ctx, cancel)
+	ctx = context.WithValue(ctx, sessionScopeKey{}, r.scope)
+	return ctx, func() { stop(); cancel(); done() }, true
+}
+
+func closeOnCancel(ctx context.Context, conn interface{ Close() error }) func() {
+	done := make(chan struct{})
+	stop := context.AfterFunc(ctx, func() { _ = conn.Close(); close(done) })
+	return func() {
+		if !stop() {
+			<-done
+		}
+	}
+}
