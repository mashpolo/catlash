+package config
+
+import (
+	C "github.com/metacubex/mihomo/constant"
+	R "github.com/metacubex/mihomo/rules"
+	RC "github.com/metacubex/mihomo/rules/common"
+)
+
+type MobileGeo interface {
+	NewGeoIP(country, target string, source, noResolve bool) (*RC.GEOIP, error)
+	NewGeoSite(country, target string) (*RC.GEOSITE, error)
+}
+
+func newDNSGeoIP(country, target string, source, noResolve bool, geo []MobileGeo) (*RC.GEOIP, error) {
+	if len(geo) > 0 && geo[0] != nil {
+		return geo[0].NewGeoIP(country, target, source, noResolve)
+	}
+	return RC.NewGEOIP(country, target, source, noResolve)
+}
+func newDNSGeoSite(country, target string, geo []MobileGeo) (*RC.GEOSITE, error) {
+	if len(geo) > 0 && geo[0] != nil {
+		return geo[0].NewGeoSite(country, target)
+	}
+	return RC.NewGEOSITE(country, target)
+}
+
+type mobileDNSRuleParser interface {
+	ParseDNSRule(kind, payload, target string, params []string) (C.Rule, error)
+}
+
+func newDNSRule(kind, payload, target string, params []string, geo []MobileGeo) (C.Rule, error) {
+	if len(geo) > 0 {
+		if parser, ok := geo[0].(mobileDNSRuleParser); ok {
+			return parser.ParseDNSRule(kind, payload, target, params)
+		}
+	}
+	if kind == "GEOSITE" && len(geo) > 0 {
+		return newDNSGeoSite(payload, target, geo)
+	}
+	return R.ParseRule(kind, payload, target, params, nil)
+}
+func isMobileDomainLogic(kind C.RuleType, geo []MobileGeo) bool {
+	if len(geo) == 0 {
+		return false
+	}
+	if _, ok := geo[0].(mobileDNSRuleParser); !ok {
+		return false
+	}
+	return kind == C.AND || kind == C.OR || kind == C.NOT
+}
