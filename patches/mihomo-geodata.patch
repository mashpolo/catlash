+package geodata
+
+import (
+	"bufio"
+	"encoding/binary"
+	"io"
+	"os"
+	"strings"
+
+	"github.com/metacubex/mihomo/component/geodata/router"
+	"google.golang.org/protobuf/encoding/protowire"
+)
+
+// Read only entry headers and the requested country, rather than loading the DAT.
+func NewMobileGeoIPMatcherFromFile(path, code string) (router.IPMatcher, error) {
+	name := strings.TrimPrefix(strings.ToLower(strings.TrimSpace(code)), "!")
+	if name == "" {
+		return nil, errMobileGeo
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil || !info.Mode().IsRegular() {
+		return nil, errMobileGeo
+	}
+	var foundOffset, foundLength int64
+	var offset int64
+	entries := 0
+	for offset < info.Size() {
+		entries++
+		if entries > 10_000 {
+			return nil, errMobileGeo
+		}
+		var header [20]byte
+		count, err := file.ReadAt(header[:], offset)
+		if err != nil && err != io.EOF {
+			return nil, errMobileGeo
+		}
+		field, wire, tagSize := protowire.ConsumeTag(header[:count])
+		if tagSize < 0 || field != 1 || wire != protowire.BytesType {
+			return nil, errMobileGeo
+		}
+		length, lengthSize := protowire.ConsumeVarint(header[tagSize:count])
+		if lengthSize < 0 {
+			return nil, errMobileGeo
+		}
+		headerSize := int64(tagSize + lengthSize)
+		if length > uint64(info.Size()-offset-headerSize) {
+			return nil, errMobileGeo
+		}
+		size := int64(length)
+		entryName, err := mobileGeoFileEntryName(io.NewSectionReader(file, offset+headerSize, size))
+		if err != nil {
+			return nil, errMobileGeo
+		}
+		if strings.EqualFold(entryName, name) {
+			if foundLength != 0 || size+headerSize > mobileGeoMaxBytes {
+				return nil, errMobileGeo
+			}
+			foundOffset, foundLength = offset, headerSize+size
+		}
+		offset += headerSize + size
+	}
+	if foundLength == 0 {
+		return nil, errMobileGeo
+	}
+	data := make([]byte, int(foundLength))
+	if _, err := file.ReadAt(data, foundOffset); err != nil {
+		return nil, errMobileGeo
+	}
+	return NewMobileGeoIPMatcher(data, code)
+}
+
+func mobileGeoFileEntryName(section io.Reader) (string, error) {
+	reader := bufio.NewReaderSize(section, 512)
+	for {
+		tag, err := binary.ReadUvarint(reader)
+		if err == io.EOF {
+			return "", nil
+		}
+		if err != nil {
+			return "", errMobileGeo
+		}
+		field, wire := protowire.DecodeTag(tag)
+		switch wire {
+		case protowire.VarintType:
+			if _, err := binary.ReadUvarint(reader); err != nil {
+				return "", errMobileGeo
+			}
+		case protowire.Fixed64Type:
+			if _, err := io.CopyN(io.Discard, reader, 8); err != nil {
+				return "", errMobileGeo
+			}
+		case protowire.Fixed32Type:
+			if _, err := io.CopyN(io.Discard, reader, 4); err != nil {
+				return "", errMobileGeo
+			}
+		case protowire.BytesType:
+			length, err := binary.ReadUvarint(reader)
+			if err != nil || length > uint64(^uint64(0)>>1) {
+				return "", errMobileGeo
+			}
+			if field == 1 {
+				if length > 256 {
+					return "", errMobileGeo
+				}
+				value := make([]byte, int(length))
+				if _, err := io.ReadFull(reader, value); err != nil {
+					return "", errMobileGeo
+				}
+				return string(value), nil
+			}
+			if _, err := io.CopyN(io.Discard, reader, int64(length)); err != nil {
+				return "", errMobileGeo
+			}
+		default:
+			return "", errMobileGeo
+		}
+	}
+}
