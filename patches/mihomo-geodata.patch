+package common
+
+import (
+	"github.com/metacubex/mihomo/component/geodata/router"
+	"github.com/metacubex/mihomo/component/mmdb"
+	"strings"
+)
+
+func NewMobileGEOIP(country, target string, source, noResolve bool, matcher router.IPMatcher, reader *mmdb.IPReader) *GEOIP {
+	return &GEOIP{country: strings.ToLower(country), adapter: target, isSourceIP: source, noResolveIP: noResolve, mobileMatcher: matcher, mobileReader: reader}
+}
+func NewMobileGEOSITE(country, target string, matcher router.DomainMatcher) *GEOSITE {
+	return &GEOSITE{country: country, adapter: target, mobileMatcher: matcher}
+}
+func NewMobileIPASN(asn, target string, source, noResolve bool, reader *mmdb.ASNReader) *ASN {
+	return &ASN{asn: asn, adapter: target, isSourceIP: source, noResolveIP: noResolve, mobileReader: reader}
+}
