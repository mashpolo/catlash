+package geodata
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/metacubex/mihomo/component/geodata/router"
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+const mobileGeoMaxBytes = 16 << 20
+const mobileGeoMaxRecords = 200_000
+
+var errMobileGeo = errors.New("invalid, missing or oversized geodata entry")
+
+func mobileGeoEntry(data []byte, code string) ([]byte, error) {
+	if len(data) > mobileGeoMaxBytes || code == "" {
+		return nil, errMobileGeo
+	}
+	var found []byte
+	entries := 0
+	for len(data) > 0 {
+		number, kind, n := protowire.ConsumeTag(data)
+		if n < 0 {
+			return nil, errMobileGeo
+		}
+		data = data[n:]
+		if number != 1 || kind != protowire.BytesType {
+			return nil, errMobileGeo
+		}
+		entry, n := protowire.ConsumeBytes(data)
+		if n < 0 {
+			return nil, errMobileGeo
+		}
+		data = data[n:]
+		entries++
+		if entries > 10_000 {
+			return nil, errMobileGeo
+		}
+		cursor := entry
+		name := ""
+		records := 0
+		for len(cursor) > 0 {
+			field, wire, n := protowire.ConsumeTag(cursor)
+			if n < 0 {
+				return nil, errMobileGeo
+			}
+			cursor = cursor[n:]
+			if field == 1 && wire == protowire.BytesType {
+				value, n := protowire.ConsumeBytes(cursor)
+				if n < 0 || len(value) > 256 || name != "" {
+					return nil, errMobileGeo
+				}
+				name = string(value)
+				cursor = cursor[n:]
+				continue
+			}
+			if field == 2 {
+				records++
+				if records > mobileGeoMaxRecords {
+					return nil, errMobileGeo
+				}
+			}
+			n = protowire.ConsumeFieldValue(field, wire, cursor)
+			if n < 0 {
+				return nil, errMobileGeo
+			}
+			cursor = cursor[n:]
+		}
+		if strings.EqualFold(name, code) {
+			if found != nil {
+				return nil, errMobileGeo
+			}
+			found = entry
+		}
+	}
+	if found == nil {
+		return nil, errMobileGeo
+	}
+	return found, nil
+}
+func NewMobileGeoIPMatcher(data []byte, code string) (router.IPMatcher, error) {
+	code = strings.ToLower(strings.TrimSpace(code))
+	negate := strings.HasPrefix(code, "!")
+	code = strings.TrimPrefix(code, "!")
+	entry, err := mobileGeoEntry(data, code)
+	if err != nil {
+		return nil, err
+	}
+	var geo router.GeoIP
+	if err := (proto.UnmarshalOptions{RecursionLimit: 64}).Unmarshal(entry, &geo); err != nil {
+		return nil, errMobileGeo
+	}
+	matcher, err := router.NewGeoIPMatcher(geo.Cidr)
+	if err != nil {
+		return nil, errMobileGeo
+	}
+	if negate {
+		matcher = router.NewNotIpMatcherGroup(matcher)
+	}
+	return matcher, nil
+}
+func NewMobileGeoSiteMatcher(data []byte, code, algorithm string) (router.DomainMatcher, error) {
+	code = strings.ToLower(code)
+	negate := strings.HasPrefix(code, "!")
+	code = strings.TrimPrefix(code, "!")
+	parts := strings.Split(code, "@")
+	name := strings.TrimSpace(parts[0])
+	attrs := parseAttrs(parts[1:])
+	entry, err := mobileGeoEntry(data, name)
+	if err != nil {
+		return nil, err
+	}
+	var geo router.GeoSite
+	if err := (proto.UnmarshalOptions{RecursionLimit: 64}).Unmarshal(entry, &geo); err != nil {
+		return nil, errMobileGeo
+	}
+	domains := geo.Domain
+	for _, domain := range domains {
+		if domain.Type < router.Domain_Plain || domain.Type > router.Domain_Full {
+			return nil, errMobileGeo
+		}
+	}
+	if !attrs.IsEmpty() {
+		filtered := make([]*router.Domain, 0, len(domains))
+		for _, domain := range domains {
+			if attrs.Match(domain) {
+				filtered = append(filtered, domain)
+			}
+		}
+		domains = filtered
+	}
+	var matcher router.DomainMatcher
+	switch algorithm {
+	case "", "succinct":
+		matcher, err = router.NewSuccinctMatcherGroup(domains)
+	case "mph", "hybrid":
+		matcher, err = router.NewMphMatcherGroup(domains)
+	default:
+		return nil, errors.New("unsupported geosite matcher")
+	}
+	if err != nil {
+		return nil, errMobileGeo
+	}
+	if negate {
+		matcher = router.NewNotDomainMatcherGroup(matcher)
+	}
+	return matcher, nil
+}
