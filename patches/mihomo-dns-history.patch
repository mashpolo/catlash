--- /dev/null
+++ b/dns/mobile_query_notify.go
@@ -0,0 +1,28 @@
+package dns
+
+import "context"
+
+type queryNotifyKey struct{}
+
+func WithQueryNotify(ctx context.Context, notify QueryNotify) context.Context {
+	return context.WithValue(ctx, queryNotifyKey{}, notify)
+}
+
+func queryNotifyFromContext(ctx context.Context) QueryNotify {
+	notify, _ := ctx.Value(queryNotifyKey{}).(QueryNotify)
+	return notify
+}
+
+func (r *Resolver) queryNotify() QueryNotify {
+	if notify := queryNotifyFromContext(r.backgroundContext()); notify != nil {
+		return notify
+	}
+	return DefaultQueryNotify
+}
+
+func (rs Resolvers) ClearSessionCache() {
+	rs.ClearCache()
+	if rs.Resolver != nil {
+		rs.Resolver.defaultResolver.ClearCache()
+	}
+}
